{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TastSong/GameProgrammerStudyNotes/ai/schemas/chunk.schema.json",
  "title": "Knowledge Chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "doc_id",
    "content_path",
    "title",
    "heading",
    "heading_path",
    "start_line",
    "end_line",
    "summary",
    "status",
    "category",
    "difficulty",
    "version_scope",
    "tags",
    "aliases",
    "code_paths",
    "content_hash",
    "doc_content_hash",
    "text"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "doc_id": {"type": "string", "minLength": 1},
    "content_path": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "heading": {"type": "string", "minLength": 1},
    "heading_path": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "start_line": {"type": "integer", "minimum": 1},
    "end_line": {"type": "integer", "minimum": 1},
    "summary": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "outline", "summary", "reviewed", "verified", "stale"]},
    "category": {"type": "string"},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "version_scope": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "code_paths": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "doc_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1}
  }
}
